# Default committed env config. Machine-local overrides go in .env.local
# (gitignored via *.local) rather than editing this file.

# Show map labels (country/state names). Off by default -- state-layer
# label decluttering still has known overlap issues (see
# .development_logs/changelog.md). Set to "true" in .env.local while
# working on labels.
VITE_SHOW_LABELS=false
